<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Evydencia.PhotoSelector.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="48"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            MaxWidth="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                FontSize="34"
                FontWeight="SemiBold"
                Text="Evydencia Escolher Fotos" />

            <TextBlock
                FontSize="20"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />

            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.PhotoCountText, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
